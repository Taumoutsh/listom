# Copiez ce fichier en .env puis adaptez les valeurs : cp .env.example .env

# Mot de passe de la page d'administration (https://votre-site/admin).
# Laissez vide pour désactiver l'administration.
ADMIN_PASSWORD=

# Port de la machine hôte sur lequel Listom est publié (docker compose).
LISTOM_PORT=3000

# Facultatif : code à saisir pour créer une liste depuis la page d'accueil.
# Vide = tout le monde peut créer une liste.
CREATION_CODE=

# À mettre à true derrière un proxy HTTPS (Caddy, Traefik, Nginx…) :
# cookies sécurisés et vraie adresse IP des visiteurs pour la limite de tentatives.
TRUST_PROXY=false

# Cookies « Secure » : auto (selon HTTPS), true ou false.
COOKIE_SECURE=auto

# Durée pendant laquelle un appareil reste connecté au mode Vœux, en jours.
SESSION_DAYS=30

# Récupérer automatiquement l'image de la page d'un cadeau à partir de son lien.
AUTO_LINK_IMAGE=true

# Facultatif : clé de signature des sessions. Vide = clé générée au premier
# démarrage et gardée dans le volume de données.
SESSION_SECRET=
