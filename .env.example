# Copiez ce fichier en .env puis adaptez les valeurs : cp .env.example .env

# Mot de passe de la page d'administration (https://votre-site/admin).
# C'est là que se créent les liens de création de listes : sans lui, personne
# ne peut créer de liste.
ADMIN_PASSWORD=

# Réseau Docker de Nginx Proxy Manager, que Listom rejoint.
# Pour le trouver : docker network ls
NPM_NETWORK=npm_default

# Port ouvert uniquement sur la machine elle-même (127.0.0.1), pour les
# vérifications. L'accès public passe par Nginx Proxy Manager.
LISTOM_PORT=6104

# Durée de validité d'un lien de création de liste, en jours.
INVITE_DAYS=30

# true derrière un proxy HTTPS (Nginx Proxy Manager, Caddy…) : cookies
# sécurisés et vraie adresse IP des visiteurs pour la limite de tentatives.
TRUST_PROXY=true

# Cookies « Secure » : auto (selon HTTPS), true ou false.
COOKIE_SECURE=auto

# Durée pendant laquelle un appareil reste connecté au mode Vœux, en jours.
SESSION_DAYS=30

# Récupérer automatiquement l'image de la page d'un cadeau à partir de son lien.
AUTO_LINK_IMAGE=true

# Facultatif : clé de signature des sessions. Vide = clé générée au premier
# démarrage et gardée dans le volume de données.
SESSION_SECRET=
